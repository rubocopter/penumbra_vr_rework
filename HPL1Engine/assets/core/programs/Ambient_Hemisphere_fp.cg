///////////////////////////////////////////////////////
/// VR HEMISPHERICAL AMBIENT FRAGMENT PROGRAM ///////
///////////////////////////////////////////////////////

void main(half4 pos : POSITION,
		  half4 lightColor : COLOR0,
		  half2 uv : TEXCOORD0,
		  half3 ambientResponse : TEXCOORD1,

		  out half4 oColor : COLOR,

		  uniform sampler2D diffuseMap : TEXUNIT0,
		  uniform float3 ambientColor)
{
	oColor = tex2D(diffuseMap, uv);
	oColor.xyz *= ambientColor * ambientResponse;
	// Small, capped preconditioning for the dark final curve. No illumination
	// is invented at zero ambient. Applies before RenderLight, RGB only.
	oColor.xyz = oColor.xyz * 0.38 + min(oColor.xyz * 3.0, 0.031);
}
