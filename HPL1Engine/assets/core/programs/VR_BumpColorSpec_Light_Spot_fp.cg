// VR enhanced coloured-specular spotlight response.

void main(half4 pos : POSITION,
		  half4 lightColor : COLOR0,
		  half2 uv : TEXCOORD0,
		  half3 lightDir : TEXCOORD1,
		  half3 halfVec : TEXCOORD2,
		  float3 spotlightUv : TEXCOORD3,
		  out half4 oColor : COLOR,
		  uniform sampler2D diffuseMap : TEXUNIT0,
		  uniform sampler2D normalMap : TEXUNIT1,
		  uniform samplerCUBE normalCubeMap : TEXUNIT2,
		  uniform sampler1D falloffMap : TEXUNIT3,
		  uniform sampler2D spotlightMap : TEXUNIT4,
		  uniform sampler1D spotNegRejectMap : TEXUNIT5,
		  uniform sampler2D specularMap : TEXUNIT6)
{
	half3 diffuse = tex2D(diffuseMap, uv).xyz;
	half luma = dot(diffuse, half3(0.299, 0.587, 0.114));
	// Retain a little baked-shadow recovery without flattening dark texture contrast.
	diffuse += (1.0 - saturate(luma / 0.28)) * 0.06;
	half3 bumpVec = (2 * tex2D(normalMap, uv) - 1).xyz;
	// Strengthen existing tangent-space relief only; flat maps stay flat.
	bumpVec = normalize(half3(bumpVec.xy * 1.65, max(bumpVec.z, 0.05)));
	half3 lightVec = normalize(lightDir);
	half3 viewHalf = normalize(halfVec);
	half ndotl = saturate((dot(lightVec, bumpVec) + 0.08) / 1.08);
	half attenuation = tex1D(falloffMap, dot(lightDir, lightDir)).x;
	half4 spotColor = tex2Dproj(spotlightMap, spotlightUv);
	half rejectNeg = tex1D(spotNegRejectMap, spotlightUv.z + 0.5).x;
	// Preserve the coloured material mask; reflections follow the real light.
	half specular = pow(saturate(dot(viewHalf, bumpVec)), 24) * 1.00 * lightColor.w * spotColor.w;
	specular *= saturate(dot(lightVec, bumpVec) * 4.0);
	half3 lit = (diffuse * ndotl + specular * tex2D(specularMap, uv).xyz) *
		lightColor.xyz * spotColor.xyz;
	oColor = half4(lit * attenuation * rejectNeg, 0);
}
